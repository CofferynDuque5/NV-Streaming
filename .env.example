# ─────────────────────────────────────────────────────────────────────────────
# NV Streaming — variables de entorno (copia este archivo a .env y complétalo).
# Nunca subas .env a git. En producción la API NO arranca con valores de ejemplo.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# Base de datos PostgreSQL (docker compose up -d levanta una local en el puerto 5432).
DATABASE_URL=postgresql://nv:nv_local_dev@localhost:5432/nv
# Base de datos que usan las pruebas de integración (se vacía en cada ejecución).
DATABASE_URL_PRUEBAS=postgresql://nv:nv_local_dev@localhost:5432/nv_test

# API
API_PUERTO=4000
# Origen público de la web. La API rechaza escrituras que vengan de otro origen (CSRF).
WEB_ORIGEN=http://localhost:3000
# Número de proxies de confianza delante de la API (para obtener la IP real del cliente).
# Desarrollo: 1 (la web de Next.js). Producción típica: 3 (Cloudflare → Caddy → Next.js).
PROXIES_DE_CONFIANZA=1
# Documentación OpenAPI en /api/docs.
DOCS_API_HABILITADA=true

# Clave de cifrado AES-256-GCM (32 bytes en base64). Genérala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CLAVE_CIFRADO=

# Sesiones
SESION_DURACION_HORAS=12
SESION_INACTIVIDAD_MINUTOS=120

# Comprobantes de pago: carpeta privada (fuera de la web) y tamaño máximo por archivo.
ALMACEN_DIR=almacen
COMPROBANTE_MAX_MB=5
# Cada cuántos minutos la API pasa vencimientos, gracia y suspensiones (0 = nunca).
VENCIMIENTOS_CADA_MINUTOS=10

# Correo: "sandbox" (lo guarda en la base de datos y lo muestra en consola) o "smtp".
CORREO_PROVEEDOR=sandbox
CORREO_REMITENTE="NV Streaming <no-responder@example.com>"
# Con docker compose, Mailpit recibe los correos en localhost:1025 y los muestra en http://localhost:8025
SMTP_HOST=
SMTP_PUERTO=587
SMTP_SEGURO=false
SMTP_USUARIO=
SMTP_CONTRASENA=

# Web (Next.js): dirección interna de la API desde el servidor de la web.
API_URL_INTERNA=http://localhost:4000
