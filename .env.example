# =============================================================================
# NV STREAMING v1.0 — Variables de entorno (PLANTILLA · SIN SECRETOS REALES)
# =============================================================================
# Copia este archivo a  whatsapp-agent/.env  y rellena los valores.
#   cp .env.example whatsapp-agent/.env
#
# Leyenda:  [OBLIGATORIA] la app no arranca sin ella  ·  [SECRETO] nunca la subas a git
#           [opcional] tiene valor por defecto  ·  [prod] cámbiala en producción
#
# NOTA: el FRONTEND (site/) NO usa .env: su configuración vive en
#       site/js/config.js (NV_CONFIG) y site/js/firebase-config.js.
#       Las CLOUD FUNCTIONS no usan .env: sus 6 secretos se cargan con
#       `firebase functions:secrets:set` (ver docs/CLOUD-FUNCTIONS.md).
#       Este archivo es para el BACKEND Node (whatsapp-agent).
# =============================================================================

# --- Entorno -----------------------------------------------------------------
NODE_ENV=production                 # [prod] usa 'production' en el servidor
PORT=3000                           # [opcional] puerto HTTP del backend
LOG_LEVEL=info                      # [opcional] error|warn|info|debug

# --- Base de datos PostgreSQL ------------------------------------------------
# [OBLIGATORIA][SECRETO] Cadena de conexión. Incluye ?sslmode=require si tu
# proveedor (Neon/Supabase/RDS/Heroku) exige SSL (el pool NO añade SSL solo).
DATABASE_URL=postgres://usuario:password@host:5432/nv_streaming?sslmode=require

# --- Cifrado de credenciales (AES-256-GCM) -----------------------------------
# [OBLIGATORIA en prod][SECRETO] 32 bytes en base64 o hex. La app NO arranca en
# prod sin ella. Genérala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ¡GUÁRDALA Y NO LA CAMBIES! Si la pierdes, las credenciales cifradas guardadas
# quedan indescifrables para siempre.
CREDENTIALS_ENC_KEY=

# --- OpenAI (agente de IA) ---------------------------------------------------
OPENAI_API_KEY=                     # [SECRETO] sin ella el agente NO responde. De https://platform.openai.com/api-keys
OPENAI_MODEL=gpt-4o-mini            # [opcional] modelo por defecto

# --- WhatsApp Cloud API (Meta) -----------------------------------------------
WHATSAPP_VERIFY_TOKEN=              # [OBLIGATORIA] token que tú inventas; lo pones también en Meta al registrar el webhook
WHATSAPP_APP_SECRET=                # [OBLIGATORIA][SECRETO] App Secret de tu app de Meta (valida la firma X-Hub-Signature-256)
WHATSAPP_ACCESS_TOKEN=              # [SECRETO][prod] token permanente de usuario de sistema; sin él NO se envían mensajes
WHATSAPP_PHONE_NUMBER_ID=           # [prod] Phone Number ID del número emisor
WHATSAPP_API_VERSION=v21.0          # [opcional]
WHATSAPP_TEMPLATE_VENCIMIENTO=vencimiento_perfil   # [opcional] nombre de plantilla aprobada en Meta (5 variables de cuerpo)
WHATSAPP_TEMPLATE_LANG=es           # [opcional]

# --- Admin -------------------------------------------------------------------
ADMIN_API_TOKEN=                    # [SECRETO] Bearer para endpoints de pagos admin; sin él responden 503
ADMIN_WHATSAPP=                     # [opcional] número para alertas de stock/operación

# --- Datos de recepción de pagos (se muestran al cliente) --------------------
PAGO_MOVIL_BANCO=                   # p.ej. "Banco de Venezuela"
PAGO_MOVIL_CEDULA=                  # cédula del titular
PAGO_MOVIL_TELEFONO=                # teléfono Pago Móvil
PAGO_MOVIL_TITULAR=                 # nombre del titular
BINANCE_EMAIL=                      # Binance Pay ID / correo
ZELLE_EMAIL=                        # correo Zelle
ZELLE_TITULAR=                      # titular Zelle

# --- Pasarelas automáticas (webhooks entrantes) — opcionales -----------------
BINANCE_PAY_KEY=                    # [SECRETO] merchant key
BINANCE_PAY_SECRET=                 # [SECRETO] secreto HMAC del webhook; sin él se rechaza el webhook de Binance
PAGO_MOVIL_WEBHOOK_SECRET=          # [SECRETO] secreto HMAC del puente PagoMóvil (debes construir ese puente; no viene incluido)
PSP_STRICT_AMOUNT=on                # [opcional] rechaza pagos con monto/moneda que no cuadran

# --- Email (SMTP) — opcional (si vacío, el email queda desactivado) ----------
SMTP_HOST=                          # host SMTP; vacío = sin emails de bienvenida/factura
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=                          # [SECRETO]
EMAIL_FROM=NV Streaming <no-reply@tudominio.com>
TERMS_URL=https://tudominio.com/terminos
EMPRESA_NOMBRE=NV Streaming

# --- Cron (automatizaciones) -------------------------------------------------
REMINDER_DIAS_ANTES=3               # días antes del vencimiento para recordar
CRON_EXPIRY_REMINDER=0 9 * * *      # recordatorios: 9:00 diario
CRON_RENEWALS=0 */6 * * *           # ciclo de renovaciones: cada 6 h
CRON_TZ=America/Caracas
CRON_ENABLED=on                     # 'off' si usas un scheduler externo en vez del cron interno

# --- Solo docker-compose (no las lee la app directamente) --------------------
POSTGRES_USER=nv
POSTGRES_PASSWORD=
POSTGRES_DB=nv_streaming
APP_PORT=3000

# --- Auth web (login por email/contraseña con JWT) ---------------------------
JWT_SECRET=            # [OBLIGATORIA en prod][SECRETO] node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_EXPIRES_IN=7d      # [opcional] duración del token de sesión

# --- OTP (webhooks Telegram/WhatsApp, portado de las Cloud Functions) --------
TELEGRAM_WEBHOOK_SECRET=   # [SECRETO] valida POST /otp/telegram
WHATSAPP_OTP_TOKEN=        # [SECRETO] valida POST /otp/whatsapp
TELEGRAM_BOT_TOKEN=        # [SECRETO] token del bot para reenviar el código al cliente

# --- CORS (frontend en otro dominio) ----------------------------------------
CORS_ORIGIN=*          # [prod] pon el dominio de tu frontend para restringirlo
