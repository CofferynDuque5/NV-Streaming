# ─────────────────────────────────────────────────────────────────────────────
# NV Streaming — variables de entorno (copia este archivo a .env y complétalo).
# Nunca subas .env a git. En producción la API NO arranca con valores de ejemplo.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# Base de datos PostgreSQL (docker compose up -d levanta una local en el puerto 5432).
DATABASE_URL=postgresql://nv:nv_local_dev@localhost:5432/nv
# Base de datos que usan las pruebas de integración (se vacía en cada ejecución).
DATABASE_URL_PRUEBAS=postgresql://nv:nv_local_dev@localhost:5432/nv_test

# API
API_PUERTO=4000
# Origen público de la web. La API rechaza escrituras que vengan de otro origen (CSRF).
WEB_ORIGEN=http://localhost:3000
# Número de proxies de confianza delante de la API (para obtener la IP real del cliente).
# Desarrollo: 1 (la web de Next.js). Producción típica: 3 (Cloudflare → Caddy → Next.js).
PROXIES_DE_CONFIANZA=1
# Documentación OpenAPI en /api/docs.
DOCS_API_HABILITADA=true

# Clave de cifrado AES-256-GCM (32 bytes en base64). Genérala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CLAVE_CIFRADO=

# Sesiones
SESION_DURACION_HORAS=12
SESION_INACTIVIDAD_MINUTOS=120

# Comprobantes de pago: carpeta privada (fuera de la web) y tamaño máximo por archivo.
ALMACEN_DIR=almacen
COMPROBANTE_MAX_MB=5
# ── Trabajador (automatizaciones) ───────────────────────────────────────────
# Proceso aparte: `pnpm start:trabajador` (dist/trabajador.js; `pnpm dev` ya lo arranca).
# Programa las automatizaciones, procesa la cola de trabajos en PostgreSQL y pasa los
# vencimientos. Se pueden ejecutar varios a la vez sin duplicar nada.
# Cada cuántos minutos el trabajador pasa vencimientos, gracia y suspensiones (0 = nunca).
VENCIMIENTOS_CADA_MINUTOS=10
# Respaldo si NO ejecutas el trabajador: la API también pasa los vencimientos. Los avisos
# quedan en cola hasta que arranque un trabajador.
VENCIMIENTOS_EN_API=false
# Segundos que espera el trabajador cuando la cola está vacía.
TRABAJADOR_ESPERA_SEGUNDOS=5

# ── WhatsApp ────────────────────────────────────────────────────────────────
# "desactivado" (por defecto), "sandbox" (solo lo registra; no se permite en producción)
# o "cloud_api" (WhatsApp Cloud API oficial de Meta).
# Meta solo deja que la empresa inicie conversaciones con PLANTILLAS APROBADAS: crea en
# WhatsApp Manager las plantillas nv_recordatorio_vencimiento, nv_factura_renovacion,
# nv_aviso_gracia, nv_aviso_suspension y nv_aviso_reactivacion (parámetros en
# apps/api/src/avisos/whatsapp.ts). Solo se escribe a clientes con consentimiento registrado.
WHATSAPP_PROVEEDOR=desactivado
# Token de acceso del usuario del sistema y id del número (Meta for Developers → WhatsApp).
WHATSAPP_TOKEN=
WHATSAPP_TELEFONO_ID=
# Idioma en el que aprobaste las plantillas ("es", "es_MX"...).
WHATSAPP_IDIOMA=es
WHATSAPP_API_VERSION=v23.0

# ── Tasa del bolívar automática ─────────────────────────────────────────────
# Página oficial del BCV de la que se lee el dólar (se activa en el panel de automatizaciones).
TASA_BCV_URL=https://www.bcv.org.ve/
# Fuente alternativa en JSON (solo https) y ruta del campo con el valor, p. ej. "usd.valor".
TASA_JSON_URL=
TASA_JSON_CAMPO=

# Correo: "sandbox" (lo guarda en la base de datos y lo muestra en consola) o "smtp".
CORREO_PROVEEDOR=sandbox
CORREO_REMITENTE="NV Streaming <no-responder@example.com>"
# Con docker compose, Mailpit recibe los correos en localhost:1025 y los muestra en http://localhost:8025
SMTP_HOST=
SMTP_PUERTO=587
SMTP_SEGURO=false
SMTP_USUARIO=
SMTP_CONTRASENA=

# Web (Next.js): dirección interna de la API desde el servidor de la web.
API_URL_INTERNA=http://localhost:4000
