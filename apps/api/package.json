{
  "name": "@nv/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "concurrently -k -n tsc,api,trabajador \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --env-file-if-exists=../../.env --watch-path=dist --enable-source-maps dist/main.js\" \"node --env-file-if-exists=../../.env --watch-path=dist --enable-source-maps dist/trabajador.js\"",
    "start": "node --enable-source-maps dist/main.js",
    "start:trabajador": "node --enable-source-maps dist/trabajador.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integracion",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/static": "^10.1.4",
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-fastify": "^12.1.0",
    "@nestjs/swagger": "^12.0.2",
    "@node-rs/argon2": "^2.2.1",
    "@nv/db": "workspace:*",
    "@nv/shared": "workspace:*",
    "fastify": "^5.12.5",
    "nodemailer": "^10.0.10",
    "otplib": "^13.5.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.0",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "concurrently": "^10.0.5",
    "vitest": "^5.0.1"
  }
}
