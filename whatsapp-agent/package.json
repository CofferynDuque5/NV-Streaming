{
  "name": "nv-stream-whatsapp-agent",
  "version": "0.1.0",
  "description": "Agente de IA por WhatsApp para NV Stream — webhook, Function Calling y renovaciones (Paso 1: schema + webhook)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && npm run copy:assets",
    "copy:assets": "node -e \"const fs=require('fs');fs.mkdirSync('dist/db',{recursive:true});fs.copyFileSync('src/db/schema.sql','dist/db/schema.sql')\"",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:agent": "tsx test/agent.test.ts",
    "test:crypto": "tsx test/crypto.test.ts",
    "test:chat": "tsx test/chat.test.ts",
    "test": "npm run typecheck && npm run test:agent && npm run test:crypto && npm run test:chat && npm run test:whatsapp && npm run test:renewals && npm run test:reminders && npm run test:payments && npm run test:psp && npm run test:email && npm run test:superbackend",
    "job:renewals": "tsx src/jobs/renewals.job.ts",
    "test:renewals": "tsx test/renewals.test.ts",
    "test:whatsapp": "tsx test/whatsapp.test.ts",
    "job:expiry-reminders": "tsx src/jobs/expiry-reminders.job.ts",
    "test:reminders": "tsx test/reminders.test.ts",
    "test:payments": "tsx test/payments.test.ts",
    "migrate:prod": "node dist/db/migrate.js",
    "job:renewals:prod": "node dist/jobs/renewals.job.js",
    "job:expiry:prod": "node dist/jobs/expiry-reminders.job.js",
    "test:psp": "tsx test/psp.test.ts",
    "test:email": "tsx test/email.test.ts",
    "test:superbackend": "tsx test/superbackend.smoke.test.ts",
    "test:auth": "tsx test/auth.test.ts",
    "test:cms": "tsx test/cms.test.ts",
    "test:wallet": "tsx test/wallet.test.ts",
    "test:orders": "tsx test/orders.test.ts",
    "crear-admin": "tsx src/scripts/crear-admin.ts",
    "seed:cms": "tsx src/scripts/seed-cms.ts",
    "crear-admin:prod": "node dist/scripts/crear-admin.js",
    "seed:cms:prod": "node dist/scripts/seed-cms.js",
    "test:migrate": "tsx test/migrate.test.ts",
    "test:userdocs": "tsx test/userdocs.test.ts",
    "test:otp": "tsx test/otp.test.ts",
    "test:provisioning": "tsx test/provisioning.test.ts",
    "test:integration": "tsx test/integration.http.test.ts",
    "seed": "tsx src/scripts/seed.ts",
    "seed:prod": "node dist/scripts/seed.js",
    "hydrate": "npm run migrate && npm run seed"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.10.1",
    "openai": "^4.104.0",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "pino-pretty": "^11.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.10",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.24",
    "@types/pg": "^8.11.6",
    "pg-mem": "^3.0.14",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
