# ════════════════════════════════════════════════════════════════════
#  NV Stream · Agente de WhatsApp — .env (copia a `.env` y completa)
#  Genera secretos:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ════════════════════════════════════════════════════════════════════

# ───────────────────────────── Servidor ─────────────────────────────
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# ─────────────────────── Base de datos (PostgreSQL) ─────────────────
# Desarrollo local (sin Docker): usa esta URL.
DATABASE_URL=postgresql://nv:nv@localhost:5432/nv_stream
# Docker Compose: la app deriva el DATABASE_URL a partir de estas (host `db`).
POSTGRES_USER=nv
POSTGRES_PASSWORD=cambia_esta_password
POSTGRES_DB=nv_stream
APP_PORT=3000

# ─────────────────────────── IA · OpenAI ────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# ─────────────────────── WhatsApp Cloud API (Meta) ───────────────────
# Token que TÚ inventas; se registra en Meta y se compara con hub.verify_token.
WHATSAPP_VERIFY_TOKEN=cambia-esto-por-un-token-secreto
# App Secret (Meta → Configuración → Básica) — valida la firma X-Hub-Signature-256.
WHATSAPP_APP_SECRET=tu_app_secret_de_meta
# Token de acceso PERMANENTE (usuario del sistema) — para enviar mensajes.
WHATSAPP_ACCESS_TOKEN=tu_access_token_permanente
# ID del número emisor y versión de la API.
WHATSAPP_PHONE_NUMBER_ID=1234567890
WHATSAPP_API_VERSION=v21.0
# Plantilla APROBADA para el aviso de vencimiento (body con 5 variables).
WHATSAPP_TEMPLATE_VENCIMIENTO=vencimiento_perfil
WHATSAPP_TEMPLATE_LANG=es

# ─────────────── Cifrado de credenciales en reposo (AES-256-GCM) ─────
# OBLIGATORIA en producción. 32 bytes en base64 o hex (64 chars).
CREDENTIALS_ENC_KEY=

# ───────────────────────── Pasarela de pago ─────────────────────────
# Token de los endpoints admin (confirmar/rechazar). Sin él quedan deshabilitados.
ADMIN_API_TOKEN=
# WhatsApp del admin para alertas (stock agotado, cola de espera).
ADMIN_WHATSAPP=
# Datos de recepción (instrucciones de pago mostradas al cliente).
PAGO_MOVIL_BANCO=Banco de Venezuela
PAGO_MOVIL_CEDULA=V-12345678
PAGO_MOVIL_TELEFONO=04120000000
PAGO_MOVIL_TITULAR=Nathan Quevedo
BINANCE_EMAIL=pagos@nvstreaming.com
ZELLE_EMAIL=nathan.quevedo@nvstreaming.com
ZELLE_TITULAR=Nathan Quevedo

# ─────────── Cobro automático · Webhooks del PSP ───────────
# Binance Pay: secreto de la API del comercio (verifica la firma del webhook).
BINANCE_PAY_KEY=
BINANCE_PAY_SECRET=
# Pago Móvil: secreto compartido con tu puente/agregador (HMAC-SHA256).
PAGO_MOVIL_WEBHOOK_SECRET=
# 'on' = rechaza si la moneda del PSP no es comparable con la del plan (p. ej.
# VES vs USD sin tasa). 'off' = confirma por referencia (menos estricto).
PSP_STRICT_AMOUNT=on

# ─────────────────────── Correo (SMTP · bienvenida + factura) ────────
# Sin SMTP_HOST el correo queda deshabilitado (solo log).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=NV Stream <no-reply@nvstreaming.com>
TERMS_URL=https://nvstreaming.com/terminos
EMPRESA_NOMBRE=NV Stream

# ─────────────────────────── Tareas programadas ─────────────────────
REMINDER_DIAS_ANTES=3
CRON_EXPIRY_REMINDER=0 9 * * *
CRON_RENEWALS=0 */6 * * *
CRON_TZ=America/Caracas
CRON_ENABLED=on

# ── Auth web (login por email/contraseña con JWT) ──
JWT_SECRET=            # [OBLIGATORIA en prod][SECRETO] genera: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_EXPIRES_IN=7d      # duración del token de sesión

# ── OTP (portado de las Cloud Functions) ──
TELEGRAM_WEBHOOK_SECRET=   # [SECRETO] valida el webhook POST /otp/telegram (vacío = sin validar, solo dev)
WHATSAPP_OTP_TOKEN=        # [SECRETO] valida el webhook POST /otp/whatsapp
TELEGRAM_BOT_TOKEN=        # [SECRETO] token del bot para reenviar el código al cliente por Telegram

# Acceso con Google (opcional): mismo Client ID OAuth Web que en el frontend.
GOOGLE_CLIENT_ID=
