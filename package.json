{
  "name": "nv-streaming",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "pnpm --filter @nv/web test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @nv/db migrate:dev",
    "db:deploy": "pnpm --filter @nv/db migrate:deploy",
    "db:seed": "pnpm --filter @nv/db seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  },
  "type": "module"
}
